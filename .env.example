# Every environment variable any script in this repo reads, grouped by
# what uses it. Copy to `.env` and fill in what you need — nothing here
# reads `.env` automatically (no dotenv dependency); export these into
# your shell yourself, or use `env $(cat .env | xargs) npm run ...`.
#
# See README.md's Quick Start and Usage sections for what each of these
# actually does — this file is just the enumeration, not the explanation.

# --- Core (src/db.ts) ---------------------------------------------------
# Optional — defaults to postgresql://postgres:devpass@localhost:5432/principalgraph
DATABASE_URL=

# --- MCP-config adapter (scripts/run-mcp-config-adapter.ts) ------------
# Optional — defaults to <os user>@<hostname>
PRINCIPAL_GRAPH_AGENT_ID=

# --- GitHub adapter (scripts/run-github-adapter.ts) ---------------------
PRINCIPAL_GRAPH_GITHUB_TOKEN=
PRINCIPAL_GRAPH_GITHUB_REPOS=

# --- AWS adapter (scripts/run-aws-adapter.ts) ----------------------------
# AWS credentials themselves come from the SDK's own default provider
# chain (same as the AWS CLI) — not an env var this repo reads directly.
PRINCIPAL_GRAPH_AWS_BUCKETS=
PRINCIPAL_GRAPH_AWS_PRINCIPAL_ARNS=
# Optional
AWS_REGION=

# --- Workspace adapter (scripts/run-workspace-adapter.ts) ---------------
PRINCIPAL_GRAPH_WORKSPACE_GROUPS=
PRINCIPAL_GRAPH_WORKSPACE_ADMIN_EMAIL=
GOOGLE_APPLICATION_CREDENTIALS=

# --- RBA exporter (scripts/run-rba-exporter.ts) --------------------------
RBA_API_URL=
RBA_API_KEY=

# --- Report server (scripts/run-server.ts) -------------------------------
PRINCIPAL_GRAPH_REPORT_API_KEY=
