{
  "name": "principal-graph",
  "version": "1.3.0",
  "description": "One model of who and what can reach your systems, and what they actually did. Humans and agents are the same kind of principal, so one query answers both. Grant graph plus tamper-evident event log, for companies too small to have a security team.",
  "type": "module",
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "test ! -e node_modules/.bin/tsc || test ! -e tsconfig.build.json || npm run build",
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.scripts.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.ts\" \"*.{js,ts,json}\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.ts\" \"*.{js,ts,json}\"",
    "verify": "npm run typecheck && npm run build && npm test && npm run lint && npm run format:check",
    "adapter:mcp-config": "tsx scripts/run-mcp-config-adapter.ts",
    "adapter:github": "tsx scripts/run-github-adapter.ts",
    "adapter:aws": "tsx scripts/run-aws-adapter.ts",
    "adapter:workspace": "tsx scripts/run-workspace-adapter.ts",
    "adapter:postgres": "tsx scripts/run-postgres-adapter.ts",
    "adapter:postgres-usage": "tsx scripts/run-postgres-usage-adapter.ts",
    "export:rba": "tsx scripts/run-rba-exporter.ts",
    "migrate": "tsx scripts/run-migrations.ts",
    "adapter-status": "tsx scripts/run-adapter-status.ts",
    "report": "tsx scripts/report.ts",
    "serve": "tsx scripts/run-server.ts",
    "policy-check": "tsx scripts/run-policy-check.ts",
    "verify-chain": "tsx scripts/run-verify-chain.ts",
    "sync": "tsx scripts/run-sync.ts",
    "erase-identity": "tsx scripts/run-erasure.ts",
    "doctor": "tsx scripts/run-doctor.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NovaVey/Principal-Graph.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/NovaVey/Principal-Graph/issues"
  },
  "homepage": "https://github.com/NovaVey/Principal-Graph#readme",
  "dependencies": {
    "@aws-sdk/client-iam": "^3.1131.0",
    "@aws-sdk/client-s3": "^3.1131.0",
    "@novavey/contracts": "git+https://github.com/NovaVey/Stack-Contracts.git#0fed74338c7108ff225ba48e137f75377f596718",
    "pg": "^8.23.0",
    "taint-tracked-tool-broker": "git+https://github.com/NovaVey/Taint-Tracked-Tool-Broker.git#ca46d562a66f9eb759d29e6e9641b4562f18e0f4"
  },
  "devDependencies": {
    "@types/node": "^24.13.4",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  }
}
